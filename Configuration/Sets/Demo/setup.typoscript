@import 'EXT:dlf/Configuration/TypoScript/setup.typoscript'

page = PAGE
page {
    cssInline.10 = TEXT
    cssInline.10.value (
        .demo-home { display: flex; flex-direction: column; align-items: center; }
        .demo-columns { display: flex; gap: 2em; }
        .demo-sidebar { flex: 0 0 20em; }
        .demo-main { flex: 1; }
        /* Search results with index (list marker), thumbnail and metadata side by side. */
        .tx-dlf-abstracts > li { margin-bottom: 1em; }
        .tx-dlf-abstracts > li > a { display: flex; gap: 1em; align-items: center; }
        .tx-dlf-abstracts dl { display: grid; grid-template-columns: auto 1fr; gap: 0 0.5em; margin: 0; }
        .tx-dlf-abstracts dt { font-weight: bold; }
        .tx-dlf-abstracts dd { margin: 0; }
        /* The search plugin in the sidebar only shows the facets. */
        .demo-sidebar .tx-dlf-search-form { display: none; }
        /* Navigation and toolbox links as buttons, unavailable actions are rendered as "span". */
        .frame-type-dlf_navigation, .frame-type-dlf_toolbox { display: flex; flex-wrap: wrap; gap: 0.4em; margin-bottom: 0.4em; }
        .frame-type-dlf_navigation > *, .frame-type-dlf_toolbox > * { list-style: none; }
        .frame-type-dlf_navigation :is(a, span, select), .frame-type-dlf_toolbox :is(a, span) { display: inline-block; padding: 0.2em 0.6em; border: 1px solid #999; border-radius: 3px; color: inherit; text-decoration: none; }
        .frame-type-dlf_navigation span, .frame-type-dlf_toolbox span { color: #999; border-color: #ddd; }
        /* The map of the PageView plugin needs an explicit height, the background shows the edges of white pages. */
        .tx-dlf-map { height: 600px; background: #eee; }
        /* Viewer filling the window: the map takes the remaining space, the sidebar scrolls on its own. */
        body:has(.demo-viewer) { margin: 0; }
        .demo-viewer { display: flex; flex-direction: column; height: 100vh; padding: 0 0.5em; box-sizing: border-box; }
        .demo-viewer .demo-columns { flex: 1; min-height: 0; }
        .demo-viewer .demo-sidebar { overflow-y: auto; }
        .demo-viewer .demo-main { position: relative; }
        .demo-viewer .tx-dlf-map { position: absolute; inset: 0; height: auto; }
    )

    10 = PAGEVIEW
    10 {
        paths.10 = EXT:dlf/Resources/Private/Bootstrap/Templates/

        variables {
            contentMain < styles.content.get

            contentSidebar < styles.content.get
            contentSidebar.select.where = {#colPos}=1

            contentHeader < styles.content.get
            contentHeader.select.where = {#colPos}=2
        }

        dataProcessing.10 = menu
        dataProcessing.10 {
            levels = 2
            as = mainMenu
        }
    }
}
