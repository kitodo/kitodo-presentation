<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.sheet</sheetTitle>
                <type>array</type>
                <el>
                    <settings.paginate.itemsPerPage>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:pageGrid.flexForm.limit</label>
                        <config>
                            <type>number</type>
                            <required>true</required>
                            <format>integer</format>
                            <default>24</default>
                        </config>
                    </settings.paginate.itemsPerPage>
                    <settings.placeholder>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:pageGrid.flexForm.placeholder</label>
                        <config>
                            <type>file</type>
                            <maxitems>1</maxitems>
                            <allowed>gif,jpg,jpeg,png</allowed>
                            <appearance type="array">
                                <headerThumbnail>
                                    <field>uid_local</field>
                                    <height>64</height>
                                    <width>64</width>
                                </headerThumbnail>
                                <enabledControls>
                                    <info>1</info>
                                    <new>0</new>
                                    <dragdrop>0</dragdrop>
                                    <sort>1</sort>
                                    <hide>0</hide>
                                    <delete>1</delete>
                                    <localize>1</localize>
                                </enabledControls>
                                <createNewRelationLinkTitle>LLL:EXT:frontend/Resources/Private/Language/locallang_ttc.xlf:images.addFileReference</createNewRelationLinkTitle>
                            </appearance>
                            <behaviour>
                                <allowLanguageSynchronization>true</allowLanguageSynchronization>
                            </behaviour>
                        </config>
                    </settings.placeholder>
                    <settings.targetPid>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.targetPidPageView</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>1</minitems>
                            <show_thumbs>1</show_thumbs>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.targetPid>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
