<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.sheet</sheetTitle>
                <type>array</type>
                <el>
                    <settings.fulltext>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.fulltext</label>
                        <config>
                            <type>radio</type>
                            <items>
                                <numIndex index="0">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.text.yes</label>
                                    <value>1</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.text.no</label>
                                    <value>0</value>
                                </numIndex>
                            </items>
                            <maxitems>1</maxitems>
                            <minitems>1</minitems>
                        </config>
                    </settings.fulltext>
                    <settings.fulltextPreselect>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.fulltextPreselect</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.fulltextPreselect>
                    <settings.datesearch>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.dateSearch</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.datesearch>
                    <settings.solrcore>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.solrCore</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_dlf_solrcores</foreign_table>
                            <foreign_table_where>ORDER BY tx_dlf_solrcores.label ASC</foreign_table_where>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.solrcore>
                    <settings.extendedSlotCount>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.extSearch.slotCount</label>
                        <config>
                            <type>number</type>
                            <format>integer</format>
                            <range>
                                <lower>0</lower>
                                <upper>10</upper>
                            </range>
                            <default>0</default>
                        </config>
                    </settings.extendedSlotCount>
                    <settings.extendedFields>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.extSearch.fields</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <items type="array"></items>
                            <itemsProcFunc>Kitodo\Dlf\Hooks\ItemsProcFunc->extendedSearchList</itemsProcFunc>
                            <size>5</size>
                            <autoSizeMax>15</autoSizeMax>
                            <maxitems>10</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.extendedFields>
                    <settings.searchIn>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.searchIn</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.text.none</label>
                                    <value>none</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.searchIn.document</label>
                                    <value>document</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.searchIn.collection</label>
                                    <value>collection</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.searchIn.all</label>
                                    <value>all</value>
                                </numIndex>
                            </items>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.searchIn>
                    <settings.collections>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.collections</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <foreign_table>tx_dlf_collections</foreign_table>
                            <foreign_table_where>AND tx_dlf_collections.hidden = 0 AND tx_dlf_collections.sys_language_uid IN (-1,0)
                                ORDER BY tx_dlf_collections.label ASC
                            </foreign_table_where>
                            <size>5</size>
                            <autoSizeMax>15</autoSizeMax>
                            <items type="array"></items>
                            <itemsProcFunc>Kitodo\Dlf\Hooks\ItemsProcFunc->getFacetsList</itemsProcFunc>
                            <maxitems>1024</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.collections>
                    <settings.facets>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.facets</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <items type="array"></items>
                            <itemsProcFunc>Kitodo\Dlf\Hooks\ItemsProcFunc->getFacetsList</itemsProcFunc>
                            <size>5</size>
                            <autoSizeMax>15</autoSizeMax>
                            <maxitems>1024</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.facets>
                    <settings.facetCollections>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.facets.collections</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <foreign_table>tx_dlf_collections</foreign_table>
                            <foreign_table_where>AND tx_dlf_collections.hidden = 0 AND tx_dlf_collections.sys_language_uid IN (-1,0)
                                ORDER BY tx_dlf_collections.label ASC
                            </foreign_table_where>
                            <size>5</size>
                            <autoSizeMax>15</autoSizeMax>
                            <maxitems>1024</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.facetCollections>
                    <settings.limitFacets>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.facets.limit</label>
                        <config>
                            <type>number</type>
                            <format>integer</format>
                            <range>
                                <lower>1</lower>
                                <upper>50000</upper>
                            </range>
                            <default>15</default>
                        </config>
                    </settings.limitFacets>
                    <settings.resetFacets>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.facets.reset</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.resetFacets>
                    <settings.sortingFacets>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.facets.sorting</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexform.facets.sorting.count</label>
                                    <value>count</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexform.facets.sorting.index</label>
                                    <value>index</value>
                                </numIndex>
                            </items>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.sortingFacets>
                    <settings.suggest>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.suggest</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.suggest>
                    <settings.showLogicalPageField>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.showLogicalPageField</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.showLogicalPageField>
                    <settings.showSingleResult>
                        <onChange>reload</onChange>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:search.flexForm.showSingleResult</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.showSingleResult>
                    <settings.targetPid>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.targetPidListView</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.targetPid>
                    <settings.targetPidPageView>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.targetPidPageView</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.targetPidPageView>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
