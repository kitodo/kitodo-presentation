<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.sheet</sheetTitle>
                <type>array</type>
                <el>
                    <settings.library>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.library</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_dlf_libraries</foreign_table>
                            <foreign_table_where>AND tx_dlf_libraries.sys_language_uid IN (-1,0)
                                ORDER BY tx_dlf_libraries.label ASC
                            </foreign_table_where>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.library>
                    <settings.limit>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:oaiPmh.flexForm.limit</label>
                        <config>
                            <type>number</type>
                            <required>true</required>
                            <format>integer</format>
                            <default>5</default>
                        </config>
                    </settings.limit>
                    <settings.expired>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:oaiPmh.flexForm.expired</label>
                        <config>
                            <type>number</type>
                            <required>true</required>
                            <format>integer</format>
                            <default>1800</default>
                        </config>
                    </settings.expired>
                    <settings.showUserDefined>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:oaiPmh.flexForm.showUserDefined</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.showUserDefined>
                    <settings.solrcore>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:general.flexForm.solrCore</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <foreign_table>tx_dlf_solrcores</foreign_table>
                            <foreign_table_where>ORDER BY tx_dlf_solrcores.label ASC</foreign_table_where>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.solrcore>
                    <settings.solrLimit>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:oaiPmh.flexForm.solrLimit</label>
                        <config>
                            <type>number</type>
                            <required>true</required>
                            <format>integer</format>
                            <default>50000</default>
                        </config>
                    </settings.solrLimit>
                    <settings.stylesheet>
                        <exclude>1</exclude>
                        <label>LLL:EXT:dlf/Resources/Private/Language/locallang_be.xlf:oaiPmh.flexForm.stylesheet</label>
                        <config>
                            <type>file</type>
                            <allowed>xsl,xslt</allowed>
                            <maxitems>1</maxitems>
                            <appearance type="array">
                                <enabledControls>
                                    <info>1</info>
                                    <new>0</new>
                                    <dragdrop>0</dragdrop>
                                    <sort>1</sort>
                                    <hide>0</hide>
                                    <delete>1</delete>
                                    <localize>1</localize>
                                </enabledControls>
                                <createNewRelationLinkTitle>LLL:EXT:frontend/Resources/Private/Language/locallang_ttc.xlf:media.addFileReference</createNewRelationLinkTitle>
                            </appearance>
                            <behavior>
                                <allowLanguageSynchronization>true</allowLanguageSynchronization>
                            </behavior>
                        </config>
                    </settings.stylesheet>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
